datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum NotificationType {
  EMAIL
  SMS
  PUSH
  IN_APP
}

enum NotificationChannel {
  TRANSACTIONAL
  MARKETING
  SYSTEM
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  DELIVERED
  READ
}

enum BatchStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum LogStatus {
  PENDING
  SENT
  FAILED
  DELIVERED
}

// ─── Models ──────────────────────────────────────────────────────────────────

model Notification {
  id          String              @id @default(uuid()) @db.Uuid
  user_id     String              @db.Uuid
  type        NotificationType
  channel     NotificationChannel
  title       String              @db.VarChar(255)
  body        String
  data        Json?
  read_at     DateTime?
  batch_id    String?             @db.Uuid
  created_at  DateTime            @default(now())
  updated_at  DateTime            @updatedAt

  batch       NotificationBatch?  @relation(fields: [batch_id], references: [id])
  logs        NotificationLog[]

  @@index([user_id])
  @@index([type])
  @@index([channel])
  @@index([batch_id])
  @@map("notifications")
}

model NotificationTemplate {
  id         String              @id @default(uuid()) @db.Uuid
  slug       String              @unique @db.VarChar(100)
  type       NotificationType
  channel    NotificationChannel
  subject    String?             @db.VarChar(255)
  body       String
  variables  Json
  is_active  Boolean             @default(true)
  created_at DateTime            @default(now())
  updated_at DateTime            @updatedAt

  batches    NotificationBatch[]

  @@index([type])
  @@index([channel])
  @@index([is_active])
  @@map("notification_templates")
}

model NotificationPreference {
  id         String              @id @default(uuid()) @db.Uuid
  user_id    String              @db.Uuid
  type       NotificationType
  channel    NotificationChannel
  enabled    Boolean             @default(true)
  created_at DateTime            @default(now())
  updated_at DateTime            @updatedAt

  @@unique([user_id, type, channel])
  @@index([user_id])
  @@map("notification_preferences")
}

model NotificationLog {
  id                  String          @id @default(uuid()) @db.Uuid
  notification_id     String          @db.Uuid
  provider            String          @db.VarChar(50)
  provider_message_id String?         @unique @db.VarChar(255)
  status              LogStatus       @default(PENDING)
  attempts            Int             @default(0)
  error               String?
  sent_at             DateTime?
  created_at          DateTime        @default(now())

  notification        Notification    @relation(fields: [notification_id], references: [id])

  @@index([notification_id])
  @@index([status])
  @@map("notification_logs")
}

model NotificationBatch {
  id          String              @id @default(uuid()) @db.Uuid
  template_id String              @db.Uuid
  name        String              @db.VarChar(255)
  channel     NotificationChannel
  status      BatchStatus         @default(PENDING)
  total       Int                 @default(0)
  sent        Int                 @default(0)
  failed      Int                 @default(0)
  created_at  DateTime            @default(now())
  updated_at  DateTime            @updatedAt

  template      NotificationTemplate @relation(fields: [template_id], references: [id])
  notifications Notification[]

  @@index([template_id])
  @@index([status])
  @@map("notification_batches")
}
